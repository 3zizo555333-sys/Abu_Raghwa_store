# Public Supabase client configuration (publishable/anon key only).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Server-only. Never prefix with VITE_ and never expose to browser bundles.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ONLY_IN_VERCEL_SERVER_ENV
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Server-only, required for supplier-invoice OCR through invokeLLM.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=REPLACE_ONLY_IN_SERVER_ENV
# Optional when Supabase has exactly one shop. Required for multi-shop deployments;
# use the UUID for the Abu Raghwa public storefront, server-only (not VITE_).
SUPABASE_LOYALTY_SHOP_ID=

# Vercel/CI only; do not commit these values.
# Set all variables separately for Preview and Production in Vercel.
