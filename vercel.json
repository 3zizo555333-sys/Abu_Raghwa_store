{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:web",
  "outputDirectory": "dist/public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "^/manus-storage(?:/(?<path>.*))?$",
      "dest": "/api/index.ts?__vercel_path=manus-storage/$path"
    },
    {
      "src": "^/api/health$",
      "dest": "/api/health.ts"
    },
    {
      "src": "^/api/trpc(?:/(?<path>.*))?$",
      "dest": "/api/trpc.ts?__vercel_path=api/trpc/$path"
    },
    {
      "src": "^/api(?:/(?<path>.*))?$",
      "dest": "/api/index.ts?__vercel_path=$path"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/((?!api(?:/|$)).*)$",
      "dest": "/index.html"
    }
  ]
}
